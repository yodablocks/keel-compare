{
  "name": "keel-compare",
  "version": "0.0.0",
  "private": true,
  "description": "One AI agent workflow built in keel, LangGraph.js and Temporal, compared on failure handling",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "db:up": "docker compose up -d",
    "demo:langgraph": "node langgraph/demo.ts",
    "temporal:dev": "temporal server start-dev --headless",
    "demo:temporal": "node temporal/demo.ts",
    "images": "node scripts/make-matrix.ts && \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --hide-scrollbars --force-device-scale-factor=1 --window-size=1280,640 --screenshot=\"$PWD/docs/images/social-preview.png\" \"file://$PWD/docs/images/matrix.svg\""
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0"
  }
}
